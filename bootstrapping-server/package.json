{
  "name": "p2pkit-bootstrapping-server",
  "version": "1.0.0",
  "private": true,
  "description": "Minimal WebSocket bootstrapping server for P2PKit peer-to-peer sessions.",
  "type": "module",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "node build.mjs --typecheck",
    "start": "node dist/server.js",
    "test": "node --test test/*.test.js",
    "test:proof": "node test/mm-lobby-proof.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.7.2"
  }
}
